{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ra/marquee",
  "title": "Resonance Marquee",
  "category": "resonance",
  "icon": "loop",
  "description": "Infinite ticker strip with note separators.",
  "keywords": ["ticker", "marquee", "strip"],
  "textdomain": "ra-theme",
  "supports": {
    "anchor": true
  },
  "attributes": {
    "items": {
      "type": "array",
      "default": [],
      "items": { "type": "object" }
    },
    "duration": { "type": "integer", "default": 30 }
  }
}
