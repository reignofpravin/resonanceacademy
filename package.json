{
  "name": "resonance-academy",
  "private": true,
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:php",
    "lint:js": "eslint resources/js",
    "lint:css": "stylelint \"resources/scss/**/*.scss\"",
    "lint:php": "vendor/bin/phpcs -q",
    "translate": "npm run translate:pot && npm run translate:update",
    "translate:pot": "wp i18n make-pot . ./resources/lang/ra-theme.pot --include=\"theme.json,patterns,app,resources\"",
    "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/ra-theme.pot $file; done",
    "translate:compile": "npm run translate:mo && npm run translate:js",
    "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
    "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@roots/vite-plugin": "^2.0.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "laravel-vite-plugin": "^3.0.0",
    "sass-embedded": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recess-order": "^7.9.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-scss": "^7.4.0",
    "vite": "^8.0.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "split-type": "^0.3.4"
  }
}
